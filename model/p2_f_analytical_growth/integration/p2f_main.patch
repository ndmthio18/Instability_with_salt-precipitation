+        template<class SolutionVector>
+        void transferP2FSeedFromSoil(SolutionVector& x, Scalar timeAfter)
+        {
+            const Scalar seedHeight = getParam<Scalar>("P2F.SeedHeight", 1.0e-5);
+            auto seed = p2f::activate(p2fParams_, seedHeight);
+            seed.time = timeAfter;
+
+            const auto& gridView = this->gridGeometry().gridView();
+            std::vector<Scalar> volume(x.size(), 0.0);
+            std::vector<Scalar> y(x.size(), 0.0);
+            for (const auto& element : elements(gridView))
+            {
+                auto fvGeometry = localView(this->gridGeometry());
+                fvGeometry.bind(element);
+                for (const auto& scv : scvs(fvGeometry))
+                    volume[scv.dofIndex()] += scv.volume();
+            }
+            for (const auto& vertex : vertices(gridView))
+            {
+                const auto dof = this->gridGeometry().vertexMapper().index(vertex);
+                y[dof] = vertex.geometry().center()[GridView::dimensionworld-1];
+            }
+
+            auto inventory = [&](std::size_t dof) {
+                const Scalar mole = x[dof][moleFractionIdx];
+                const Scalar total = porosity_ * sw(x[dof][pressureIdx])
+                                   * rhoW(mole) * volume[dof];
+                const Scalar salt = total * massFraction(mole);
+                return std::pair<Scalar, Scalar>(salt, total-salt);
+            };
+            Scalar saltBefore = 0.0, waterBefore = 0.0;
+            for (std::size_t dof = 0; dof < x.size(); ++dof)
+            {
+                const auto m = inventory(dof);
+                saltBefore += m.first;
+                waterBefore += m.second;
+            }
+
+            const Scalar topArea = this->gridGeometry().bBoxMax()[0]
+                                 - this->gridGeometry().bBoxMin()[0];
+            const Scalar targetSalt = seed.totalSalt()*topArea;
+            const Scalar targetWater = seed.water*topArea;
+            const Scalar yTop = this->gridGeometry().bBoxMax()[GridView::dimensionworld-1];
+            std::vector<std::size_t> candidates;
+            for (std::size_t dof = 0; dof < x.size(); ++dof)
+                if (y[dof] < yTop-1.0e-12) candidates.push_back(dof);
+            std::sort(candidates.begin(), candidates.end(),
+                      [&](auto a, auto b) { return y[a] > y[b]; });
+
+            std::vector<std::size_t> pool;
+            Scalar poolSalt = 0.0, poolWater = 0.0;
+            for (const auto dof : candidates)
+            {
+                pool.push_back(dof);
+                const auto m = inventory(dof);
+                poolSalt += m.first;
+                poolWater += m.second;
+                if (poolSalt >= 1.05*targetSalt && poolWater >= 1.05*targetWater) break;
+            }
+            if (poolSalt < targetSalt || poolWater < targetWater)
+                throw std::runtime_error("soil cannot supply the declared P2-F seed");
+
+            for (const auto dof : pool)
+            {
+                const auto old = inventory(dof);
+                const Scalar salt = old.first-targetSalt*old.first/poolSalt;
+                const Scalar water = old.second-targetWater*old.second/poolWater;
+                const Scalar total = salt+water;
+                if (!(salt > 0.0 && water > 0.0 && total > 0.0))
+                    throw std::runtime_error("P2-F seed transfer created non-positive inventory");
+                const Scalar w = salt/total;
+                const Scalar mole = w*molarMassH2O()
+                    /(molarMassNaCl()-w*(molarMassNaCl()-molarMassH2O()));
+                const Scalar saturation = total/(porosity_*rhoW(mole)*volume[dof]);
+                static const Scalar swr = getParam<Scalar>("Problem.Swr");
+                if (!(saturation > swr && saturation <= 1.0))
+                    throw std::runtime_error("P2-F seed transfer created invalid saturation");
+                static const Scalar n = getParam<Scalar>("Problem.PcN");
+                static const Scalar m = 1.0-1.0/n;
+                static const Scalar alpha = getParam<Scalar>("Problem.PcAlpha");
+                const Scalar se = (saturation-swr)/(1.0-swr);
+                const Scalar pc = std::pow(std::pow(se, -1.0/m)-1.0, 1.0/n)/alpha;
+                x[dof][pressureIdx] = nonWettingReferencePressure()-pc;
+                x[dof][moleFractionIdx] = mole;
+            }
+
+            Scalar saltAfter = 0.0, waterAfter = 0.0;
+            for (std::size_t dof = 0; dof < x.size(); ++dof)
+            {
+                const auto m = inventory(dof);
+                saltAfter += m.first;
+                waterAfter += m.second;
+            }
+            std::ofstream ledger("p2f_activation_ledger.csv");
+            ledger << std::setprecision(17)
+                << "soil_salt_before_kg,soil_salt_after_kg,seed_salt_kg,salt_residual_kg,"
+                   "soil_water_before_kg,soil_water_after_kg,seed_water_kg,water_residual_kg,pool_dofs\n"
+                << saltBefore << ',' << saltAfter << ',' << targetSalt << ','
+                << (saltAfter+targetSalt-saltBefore) << ',' << waterBefore << ','
+                << waterAfter << ',' << targetWater << ','
+                << (waterAfter+targetWater-waterBefore) << ',' << pool.size() << '\n';
+            p2fState_ = seed;
+        }
+
+        template<class SolutionVector>
+        void acceptP2FStep(SolutionVector& x, Scalar timeAfter, Scalar dt,
+                           Scalar interfaceMassFraction, Scalar interfaceSaturation)
+        {
+            if (!p2fCouplingEnabled()) return;
+            const Scalar evaporation =
+                getParam<Scalar>("P2F.PrescribedEvaporationMassFlux");
+            const bool wasActive = p2fState_.active;
+            bool activation = false;
+            Scalar velocity = 0.0, saltFlux = 0.0, waterFlux = evaporation;
+            Scalar totalFlux = evaporation, solutionPe = 0.0, movingPe = 0.0;
+            bool valid = true;
+            if (wasActive)
+            {
+                auto trial = p2f::evaluate(p2fState_, p2fParams_, evaporation, dt);
+                const auto gate = p2f::validity(
+                    p2fParams_, trial, interfaceMassFraction, interfaceSaturation);
+                velocity = trial.velocity;
+                saltFlux = trial.saltFlux;
+                waterFlux = trial.waterFlux;
+                totalFlux = trial.totalFlux;
+                solutionPe = trial.solutionPe;
+                movingPe = trial.movingPe;
+                valid = gate.valid;
+                if (valid) p2f::commit(p2fState_, trial);
+            }
+            else
+            {
+                const Scalar activationTolerance =
+                    getParam<Scalar>("P2F.ActivationRelativeTolerance", 1.0e-10);
+                if (interfaceMassFraction >= p2fParams_.equilibriumMassFraction
+                                              *(1.0-activationTolerance))
+                {
+                    transferP2FSeedFromSoil(x, timeAfter);
+                    activation = true;
+                }
+            }
+            p2fLog_ << timeAfter << ',' << dt << ',' << p2fState_.active << ','
+                << activation << ',' << evaporation << ',' << p2fState_.height << ','
+                << velocity << ',' << interfaceMassFraction << ',' << interfaceSaturation << ','
+                << saltFlux << ',' << waterFlux << ',' << totalFlux << ','
+                << p2fState_.solidSalt << ',' << p2fState_.dissolvedSalt << ','
+                << p2fState_.water << ',' << p2fState_.cumulativeEvaporation << ','
+                << solutionPe << ',' << movingPe << ',' << valid << '\n';
+            p2fLog_.flush();
+            if (!valid)
+                throw std::runtime_error("P2-F physical validity gate failed; no crust commit");
+        }

