[Grid]
Positions0              = 0 0.60
Positions1              = 0 0.20
Cells0                  = 600  
Cells1                  = 40 
Grading1                = -0.9


[TimeLoop]
TEnd = 1e7
DtInitial = 50 # [s]
MaxTimeStepSize = 50 # [s]

[Problem]
Name = salt
WaterLevel = 0.25 # [m] 
Permeability = 2.89e-11
Porosity = 0.41
Swr = 0.122
PcN = 10.8
PcAlpha = 1.77e-04 
SweL = 0.73
SaltMoleFraction= 0.0036 # [mol/mol]
EvaporationRate = 1.08e-8 # [m/s]
Amplitude = 1e-6 
WaveNumber = 8
StandardDeviationSaltMoleFraction = 1e-6 
PerturbationType = Periodic # Options: Constant, Periodic, Random 
EnableGravity = true
PerturbationHeight = 0.15

[Vtk]
Precision = Float64
AddVelocity = true
