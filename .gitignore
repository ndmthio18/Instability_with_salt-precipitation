/analysis/*/watch_status.json
/analysis/*/watch_stdout.log
/analysis/*/watch_stderr.log

# Case 42929 is still running. Track its plan and frozen snapshots, not live outputs.
/analysis/highk_unperturbed_42929_20261102/*
