# Machine-specific dependency paths belong here, not in the source lock.
/local_paths.json

# Isolated Paper 2 build products; source and compile evidence remain reviewable.
/model/transport_v1/artifacts/
/model/transport_v1/build*/

# Historical field display samples are reproducible derived fields, kept locally/remote.
/analysis/dense_history_20261102/evidence/runs/*/representative_fields.npz

# Local watcher bookkeeping; scientific run logs remain retained separately.
/analysis/*/watch_status.json
/analysis/*/watch_stdout.log
/analysis/*/watch_stderr.log

# WP10 raw trajectory products are preserved locally and on hpcc, not in Git.
/analysis/wp10_r24_long_20261104/*.tar.gz
/analysis/wp10_r24_long_20261104/run/
/analysis/wp10_r24_long_20261104/corrected_post_run/

# WP11 immutable raw archives and extracted trajectories stay local/on hpcc.  Track
# reduced CSV/JSON, figures, reports and provenance, not the multi-gigabyte fields.
/analysis/wp11_long_validation_20261105/**/*.tar.gz
/analysis/wp11_long_validation_20261105/R48_run/
/analysis/wp11_long_validation_20261105/R96_run/
/analysis/wp11_long_validation_20261105/pipeline_selftest/
# The interim archive pointer and compact reductions are tracked; complete scalar
# histories remain reproducible from the verified archive without bloating Git.
/analysis/wp11_long_validation_20261105/interim_r96_20T/snapshot/*/surface_events.csv
/analysis/wp11_long_validation_20261105/interim_r96_20T/snapshot/*/weighted_online.csv
/analysis/wp11_long_validation_20261105/interim_r96_20T/snapshot/*/transport_budget.csv
/analysis/wp11_long_validation_20261105/interim_r96_20T/R96/surface_series.csv
/analysis/wp11_long_validation_20261105/interim_r96_20T/R96/flux_series.csv

# Case 42929 is still running. Track its plan and frozen snapshots, not live outputs.
/analysis/highk_unperturbed_42929_20261102/*
!/analysis/highk_unperturbed_42929_20261102/plan.json
!/analysis/highk_unperturbed_42929_20261102/params.input
!/analysis/highk_unperturbed_42929_20261102/launch.json
!/analysis/highk_unperturbed_42929_20261102/screening.csv
!/analysis/highk_unperturbed_42929_20261102/worker.py
!/analysis/highk_unperturbed_42929_20261102/SNAPSHOT_POLICY.md
!/analysis/highk_unperturbed_42929_20261102/snapshots/
