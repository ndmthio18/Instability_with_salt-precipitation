ReferenceViscosity = 0.0011
PureWaterDensity = 998.203
DensityLinearCoefficient = 0.670804
DensityQuadraticCoefficient = 0.373854
MolarMassH2O = 0.01801528
MolarMassNaCl = 0.05844
Amplitude = 0
WaveNumber = 1
StandardDeviationSaltMoleFraction = 0
